<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="border"
	titleFont="SansSerif,0,12" darkLevel="0"
	controllerClassName="org.openflexo.fml.controller.FMLFIBInspectorController"
	dataClassName="org.openflexo.technologyadapter.markdown.MarkdownModelSlot"
	font="SansSerif,0,12" name="Inspector">
	<TabPanel name="Tab" constraints="border(location=center)">
		<Tab title="Basic" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="0" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED" name="BasicTab">
			<Label label="name" index="0"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=0;location=left)"
				name="NameLabel" localize="true" />
			<TextField index="1" data="data.name"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=1;location=right)"
				name="Name" localize="true" columns="10" />
			<Label label="document" index="2"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
				name="DocumentLabel" localize="true" />
			<Custom componentClassName="org.openflexo.components.widget.FIBResourceSelector"
				localize="true" manageDynamicModel="true" name="DocumentSelector"
				index="3" data="data.templateResource"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=3;location=right)">
				<Assignment variable="component.resourceManager"
					value="data.serviceManager.resourceManager" />
				<Assignment variable="component.technologyAdapter" value="data.modelSlotTechnologyAdapter" />
				<Assignment variable="component.resourceDataClass" value="data.type" />
			</Custom>
		</Tab>
		<Tab title="Advanced" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="1" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED" name="AdvancedTab" />
	</TabPanel>
	<LocalizedDictionary>
		<Localized key="Advanced" lang="French" value="Avancé" />
		<Localized key="Basic" lang="French" value="Basique" />
		<Localized key="name" lang="English" value="Name" />
		<Localized key="name" lang="French" value="Nom" />
		<Localized key="document" lang="English" value="Document" />
		<Localized key="document" lang="French" value="Document" />
	</LocalizedDictionary>
	<Parameter name="title" value="Markdown Model Slot" />
</Panel>
